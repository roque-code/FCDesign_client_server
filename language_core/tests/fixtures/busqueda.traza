Algoritmo Busqueda
    Definir datos, i, buscado, encontrado Como Entero;
    Dimension datos[4] Como Entero;
    datos[1] <- 4;
    datos[2] <- 7;
    datos[3] <- 9;
    datos[4] <- 2;
    Leer buscado;
    encontrado <- 0;
    Para i <- 1 Hasta 4 Hacer
        Si datos[i] = buscado Entonces
            encontrado <- i;
        FinSi
    FinPara
    Escribir encontrado;
FinAlgoritmo
