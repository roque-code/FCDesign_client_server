{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aulivana-FCDdesign",
  "version": "0.2.0",
  "identifier": "app.traza.desktop",
  "build": {
    "frontendDist": "../../frontend/dist",
    "devUrl": "http://127.0.0.1:5174",
    "beforeDevCommand": "npm run dev --prefix ../frontend -- --host 127.0.0.1 --port 5174 --strictPort",
    "beforeBuildCommand": "npm run build --prefix ../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:* http://localhost:* https: ipc: http://ipc.localhost; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/traza-host"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "deep-link": {
      "desktop": { "schemes": ["Aulivana-FCDdesign"] },
      "mobile": [{ "scheme": ["Aulivana-FCDdesign"] }]
    }
  }
}
