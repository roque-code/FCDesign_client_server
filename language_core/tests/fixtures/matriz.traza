Algoritmo Matriz
    Definir tabla, fila, columna, suma Como Entero;
    Dimension tabla[2, 3] Como Entero;
    suma <- 0;
    Para fila <- 1 Hasta 2 Hacer
        Para columna <- 1 Hasta 3 Hacer
            tabla[fila, columna] <- fila * 10 + columna;
            suma <- suma + tabla[fila, columna];
        FinPara
    FinPara
    Escribir suma;
FinAlgoritmo
